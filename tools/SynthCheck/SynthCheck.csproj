<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the mod's sound generator (src/SoundSynth.cs) outside the game, for compare.js. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\SoundSynth.cs" Link="SoundSynth.cs" />
    <EmbeddedResource Include="..\..\src\Recordings\*.wav" LogicalName="GravityGloves.Recordings.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
