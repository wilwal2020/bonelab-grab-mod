<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GravityGloves</AssemblyName>
    <RootNamespace>GravityGloves</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <!-- MelonLoader runs Il2Cpp mods on .NET 6, which is out of support. That's expected here. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Only download the .NET 6 reference pack, not the ASP.NET Core and Windows Desktop ones the SDK fetches by default. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>

  <!-- The Debug build is for testing: it logs what the mod does (Mod.Trace) and copies itself into the game. The
       Release build is for uploading: it logs only what went wrong, and is packed for Thunderstore (see Package). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);TESTLOG</DefineConstants>
  </PropertyGroup>

  <!-- The tools folder has its own projects, like tools/SynthCheck. -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <Compile Remove="release\**" />
  </ItemGroup>

  <!-- Recordings some sounds are made from, built into the mod. -->
  <ItemGroup>
    <EmbeddedResource Include="src\Recordings\*.wav" LogicalName="GravityGloves.Recordings.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Game install. Override with the BONELAB_DIR environment variable or -p:BonelabDir=... -->
  <PropertyGroup>
    <BonelabDir Condition="'$(BonelabDir)' == ''">$(BONELAB_DIR)</BonelabDir>
    <BonelabDir Condition="'$(BonelabDir)' == ''">D:\SteamLibrary\steamapps\common\BONELAB</BonelabDir>
  </PropertyGroup>

  <!-- The game's own assemblies are generated by MelonLoader on first launch. None of them get copied to the output. -->
  <ItemGroup>
    <Reference Include="$(BonelabDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(BonelabDir)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(BonelabDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BonelabDir)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BonelabDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
    <Reference Include="$(BonelabDir)\Mods\BoneLib.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the Debug build into the game's Mods folder. This only warns if the game is running and has the file locked. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BonelabDir)\Mods" Retries="0" ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Packs the Release build for Thunderstore as release/GravityGloves-<version>.zip: manifest.json, README.md and
       CHANGELOG.md from package/, the icon from art/, and the mod in Mods/, where r2modman installs MelonLoader mods
       from. Build it with: dotnet build -c Release -->
  <Target Name="Package" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\package\manifest.json')), '(?s).*"version_number":\s*"([^"]+)".*', '$1'))</PackageVersion>
      <PackageStage>$(IntermediateOutputPath)package\</PackageStage>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStage)" />
    <Copy SourceFiles="package\manifest.json;package\README.md;package\CHANGELOG.md;art\icon.png" DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStage)Mods" />
    <MakeDir Directories="release" />
    <ZipDirectory SourceDirectory="$(PackageStage)" DestinationFile="release\GravityGloves-$(PackageVersion).zip" Overwrite="true" />
    <Message Importance="high" Text="Packed release\GravityGloves-$(PackageVersion).zip" />
  </Target>

</Project>
